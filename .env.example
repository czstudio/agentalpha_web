# LLM 深度拆解服务端配置(复制为 .env.local 本地用;线上在 Vercel 项目 Settings → Environment Variables 配)
# 密钥只存在环境变量,永不进代码库
LLM_API_KEY=
# OpenAI 兼容端点(base),默认 https://api.huohuaapi.com/v1
LLM_BASE_URL=https://api.huohuaapi.com/v1
# 默认 gemini-3.1-flash-lite(按预算 3 元/天选的最便宜可用档,实测单次 ≈ ¥0.004)
LLM_MODEL=gemini-3.1-flash-lite
